# matlas 本地云路径与数据库配置；迁云时只改本文件。

# 宿主绝对路径（Docker bind mount 必须是绝对路径，Windows 用正斜杠）
MATLAS_ROOT=C:/Users/Jin/matlas

# PostgreSQL 连接参数（容器网络内服务名 postgres）
PG_DATABASE=matlas
PG_USER=matlas
PG_PASSWORD=matlas

# ── Cloudflare Pages 方案 A（静态边缘 + KV 实时）—— 可选，不上此方案可留空 ──
# 下面三项由 cloudflare-setup.bat 自动写入，手动填也可。
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=
# 推送间隔（秒），cf_push --loop 用
PUSH_INTERVAL=60
